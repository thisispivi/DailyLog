#!/bin/sh
# Fast checks on staged files only. The full gate runs on pre-push and in CI.
set -e

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

cd "$(git rev-parse --show-toplevel)/apps/daily-log"
echo "$files" | sed 's|^|../../|' | xargs -n 50 pnpm exec prettier --check --ignore-path ../../.prettierignore --ignore-unknown

lintable=$(echo "$files" | grep -E '^apps/daily-log/.*\.(ts|tsx|mjs)$' || true)
[ -n "$lintable" ] && echo "$lintable" | sed 's|^|../../|' | xargs -n 50 pnpm exec eslint --max-warnings=0 --no-warn-ignored

exit 0
