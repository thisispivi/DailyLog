{
  "name": "dailylog",
  "version": "2.6.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "description": "A private, bilingual web journal for meals, activity, sleep, and body weight.",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.21.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "format": "prettier --write .. --ignore-path ../.prettierignore",
    "format:check": "prettier --check .. --ignore-path ../.prettierignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo:build": "node scripts/prepare-demo.mjs && next build demo",
    "demo:dev": "node scripts/prepare-demo.mjs && next dev demo --port 3200",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "better-sqlite3": "13.2.0",
    "circle-flags": "2.8.3",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "pdfkit": "0.20.2",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/pdfkit": "0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "sql.js": "1.16.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
