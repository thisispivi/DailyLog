# Generate long, unique values with a password manager or secret manager.
# SESSION_SECRET (32+ characters) is required in production.
APP_PASSWORD=
SESSION_SECRET=

# Preserve the previous Telegram owner ID when migrating existing data.
# APP_USER_ID=

TIMEZONE=Europe/Berlin
DATABASE_PATH=data/dailylogbot.sqlite3
LOG_LEVEL=info

# Optional: report server errors to Bugsink (or any Sentry-compatible server).
# BUGSINK_DSN=
